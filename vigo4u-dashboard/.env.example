# .env.example
# ────────────────────────────────────────────────────────────
# Copy ไฟล์นี้ไปเป็น .env.local แล้วใส่ค่าจริง
# ห้าม commit .env.local เข้า git โดยเด็ดขาด
# ────────────────────────────────────────────────────────────

# Supabase (ดูได้ที่ Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️  อย่าใส่ SERVICE_ROLE_KEY ใน NEXT_PUBLIC_ เด็ดขาด
# ถ้าต้องการ admin operations ให้ใช้ใน Server Actions เท่านั้น
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
